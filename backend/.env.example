# Supabase → Project Settings → Database → Connection string (формат SQLAlchemy+psycopg)
DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_НЕ_отдавать_на_фронтенд
# Необязательно: только для старых проектов с HS256-секретом
# SUPABASE_JWT_SECRET=
STORAGE_BUCKET=report-photos
# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.8-flash
# Адреса сайта. Адреса мобильного приложения (https://localhost, capacitor://localhost) разрешены в коде.
CORS_ORIGINS=["http://localhost:3000"]
